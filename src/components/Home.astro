---
import Base from '../layouts/Base.astro';
import LangNav from './LangNav.astro';
import { languages, ui, type Lang } from '../i18n/ui';
import { clibs, cpp, members, ORG_URL, projectPath, type Project } from '../data/projects';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = ui[lang];

const groups: { id: string; label: string; projects: Project[] }[] = [
  { id: 'cpp', label: t.cpp.label, projects: cpp },
  { id: 'c', label: t.clibs.label, projects: clibs },
];
---

<Base lang={lang} title={t.meta.title} description={t.meta.description}>
  <a class="skip" href="#main">{t.skip}</a>

  <div class="container">
    <LangNav lang={lang} paths={{ fr: languages.fr.path, en: languages.en.path }} />

    <main id="main">
      <section class="hero">
        <h1 class="wordmark">
          <svg class="wordmark__k" viewBox="20 20 161 100" aria-hidden="true">
            <defs>
              <clipPath id="kshape"><path d="M181.0,20.0 L153.0,20.0 L132.1,58.0 L113.0,20.0 L75.0,20.0 L93.5,70.0 L20.0,120.0 L58.0,120.0 L118.9,82.0 L98.0,120.0 L126.0,120.0Z" /></clipPath>
              <clipPath id="kb1"><rect x="0" y="0" width="200" height="52" /></clipPath>
              <clipPath id="kb2"><rect x="0" y="52" width="200" height="38" /></clipPath>
              <clipPath id="kb3"><rect x="0" y="90" width="200" height="40" /></clipPath>
            </defs>
            <g clip-path="url(#kb1)"><path class="k__plate k__plate--1" d="M181.0,20.0 L153.0,20.0 L132.1,58.0 L113.0,20.0 L75.0,20.0 L93.5,70.0 L20.0,120.0 L58.0,120.0 L118.9,82.0 L98.0,120.0 L126.0,120.0Z" /></g>
            <g clip-path="url(#kb2)"><path class="k__plate k__plate--2" d="M181.0,20.0 L153.0,20.0 L132.1,58.0 L113.0,20.0 L75.0,20.0 L93.5,70.0 L20.0,120.0 L58.0,120.0 L118.9,82.0 L98.0,120.0 L126.0,120.0Z" /></g>
            <g clip-path="url(#kb3)"><path class="k__plate k__plate--3" d="M181.0,20.0 L153.0,20.0 L132.1,58.0 L113.0,20.0 L75.0,20.0 L93.5,70.0 L20.0,120.0 L58.0,120.0 L118.9,82.0 L98.0,120.0 L126.0,120.0Z" /></g>
            <rect class="k__scan" clip-path="url(#kshape)" x="0" y="20" width="10" height="100" />
          </svg>
          <span>Kronk Corp</span>
        </h1>
        <p class="hero__lead">{t.hero.lead}</p>
        <p class="hero__link"><a href={ORG_URL}>{t.hero.cta}</a></p>
      </section>

      <section class="block" aria-labelledby="about-label">
        <h2 class="label" id="about-label">{t.about.label}</h2>
        <div class="block__body about">
          {t.about.paragraphs.map((p) => <p>{p}</p>)}
          <p class="members">
            <span>{t.about.members}</span>
            {members.map((m) => <a href={`https://github.com/${m.login}`}>{m.name}</a>)}
          </p>
        </div>
      </section>

      <section class="block" aria-labelledby="kuge-label">
        <h2 class="label" id="kuge-label">{t.kuge.label}</h2>
        <div class="block__body panel">
          <h3 class="kuge__name"><a href={projectPath('KUGE', lang)}>KUGE</a></h3>
          <p class="kuge__lead">{t.kuge.lead}</p>
          <ul class="modules">
            {t.kuge.modules.map((m) => <li>{m}</li>)}
          </ul>
          <p><a href={projectPath('KUGE', lang)}>{t.kuge.cta}</a></p>
        </div>
      </section>

      {
        groups.map((g) => (
          <section class={`block block--${g.id}`} aria-labelledby={`${g.id}-label`}>
            <h2 class="label" id={`${g.id}-label`}>{g.label}</h2>
            <ul class="rows">
              {g.projects.map((p) => (
                <li class="row">
                  <a class="row__name" href={projectPath(p.repo, lang)}>{p.repo}</a>
                  <p class="row__text">
                    {p.description[lang]}
                    {p.homepage && (
                      <>
                        {' '}
                        <a href={p.homepage}>{t.site}</a>
                      </>
                    )}
                  </p>
                </li>
              ))}
            </ul>
          </section>
        ))
      }
    </main>

    <footer class="site-footer">
      <span>Kronk Corp</span>
      <a href={ORG_URL}>{t.footer.org}</a>
    </footer>
  </div>
</Base>
