---
interface Props {
  title: string;
  /** Nom exact du dépôt, affiché en mono. */
  meta?: string;
  href: string;
  /** Lien secondaire, au-dessus du lien étendu de la carte. */
  extra?: { label: string; href: string };
}
const { title, meta, href, extra } = Astro.props;
---

<article class="kc-card">
  <h3 class="kc-card__title"><a href={href}>{title}</a></h3>
  {meta && <p class="kc-card__meta">{meta}</p>}
  <p class="kc-card__text"><slot /></p>
  {extra && <p class="kc-card__extra"><a href={extra.href}>{extra.label}</a></p>}
</article>
