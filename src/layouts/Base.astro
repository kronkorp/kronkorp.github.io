---
import '../styles/tokens.css';
import '../styles/components.css';
import '../styles/global.css';
import { languages, type Lang } from '../i18n/ui';

interface Props {
  lang: Lang;
  title: string;
  description: string;
}
const { lang, title, description } = Astro.props;
const abs = (path: string) => new URL(path, Astro.site).href;
const canonical = abs(languages[lang].path);
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#161616" />
    <link rel="canonical" href={canonical} />
    {
      Object.entries(languages).map(([code, l]) => (
        <link rel="alternate" hreflang={code} href={abs(l.path)} />
      ))
    }
    <link rel="alternate" hreflang="x-default" href={abs('/')} />
    <link rel="icon" type="image/png" href="/img/kronk-corp-logo.png" />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Kronk corp" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={abs('/img/kronk-corp-logo.png')} />
    <meta property="og:locale" content={lang === 'fr' ? 'fr_FR' : 'en_US'} />

    <link rel="preload" href="/fonts/Saira-400.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/FuturaNowHeadline-Bd.otf" as="font" type="font/otf" crossorigin />
    <!-- Lexend Zetta : seule police servie par Google Fonts, comme l'indique le design system. -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Lexend+Zetta:wght@600&display=swap"
    />
  </head>
  <body>
    <slot />
  </body>
</html>
