---
import '../styles/tokens.css';
import '../styles/global.css';
import { languages, type Lang } from '../i18n/ui';

interface Props {
  lang: Lang;
  title: string;
  description: string;
  /** Chemin de cette page dans chaque langue. */
  paths?: Record<Lang, string>;
}
const { lang, title, description, paths = { fr: languages.fr.path, en: languages.en.path } } = Astro.props;
const abs = (path: string) => new URL(path, Astro.site).href;
const canonical = abs(paths[lang]);
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#161616" />
    <link rel="canonical" href={canonical} />
    {
      Object.entries(paths).map(([code, path]) => (
        <link rel="alternate" hreflang={code} href={abs(path)} />
      ))
    }
    <link rel="alternate" hreflang="x-default" href={abs(paths.fr)} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Kronk Corp" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={abs('/img/kronk-corp-logo.jpg')} />
    <meta property="og:locale" content={lang === 'fr' ? 'fr_FR' : 'en_US'} />

    <link rel="preload" href="/fonts/Saira-400.woff2" as="font" type="font/woff2" crossorigin />
    <!-- Lexend Zetta : seule police servie par Google Fonts, comme l'indique le design system. -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Lexend+Zetta:wght@600&display=swap"
    />
  </head>
  <body>
    <div class="rail rail--l" aria-hidden="true">Kronk Corp // Game engine goes brrr</div>
    <div class="rail rail--r" aria-hidden="true">C++20 / C // Epitech // Open source</div>
    <slot />
  </body>
</html>
